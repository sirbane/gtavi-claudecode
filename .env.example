# Copy to .env and fill in. Keep this file private (it is git-ignored).
COMPOSIO_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=
# Kaggle notebook model behind ngrok (leave empty to use Groq, then Ollama Cloud)
KAGGLE_OLLAMA_URL=
KAGGLE_API_KEY=
KAGGLE_MODEL=qwen2.5vl:7b
# What to post to, and how hard
PLATFORMS=facebook,youtube
AUTOPOST=1
MAX_POSTS_PER_DAY_FACEBOOK=10
MAX_POSTS_PER_DAY_YOUTUBE=5
MIN_GAP_MINUTES=45
LOOP_SLEEP_MINUTES=15
MAX_READY_CLIPS=3
FACEBOOK_PAGE_NAME=CrimeScene VI
SAFETY_MODE=strict
FFMPEG_BIN=ffmpeg
